# ------------------------------------------------------------
# 更新 systemd 配置
# ------------------------------------------------------------

set_service_config(){
    local cfg="$1"
    local tmp_unit

    [[ -f "$cfg" && -s "$cfg" && -r "$cfg" ]] || {
        red "配置文件不存在、为空或不可读取"
        return 1
    }

    case "$cfg" in
        "$ETC/"*.dae) ;;
        *)
            red "配置文件必须位于 $ETC"
            return 1
            ;;
    esac

    [[ "$cfg" != *" "* ]] || {
        red "配置文件路径不能包含空格"
        return 1
    }

    tmp_unit="$(mktemp)"

    cat > "$tmp_unit" <<EOF
[Unit]
Description=Honk eBPF Transparent Proxy Engine
Wants=network-online.target
After=network-online.target

[Service]
Type=notify
User=root
WorkingDirectory=$DATA
ExecStart=$BIN --config $cfg --disable-timestamp
ExecReload=$BIN reload
Restart=on-failure
RestartSec=3
TimeoutStopSec=30
LimitNOFILE=1048576
LimitMEMLOCK=infinity
UMask=0077

[Install]
WantedBy=multi-user.target
EOF

    install -m 0644 "$tmp_unit" "$UNIT"
    rm -f "$tmp_unit"

    printf '%s\n' "$cfg" > "$ACTIVE"
    chmod 600 "$ACTIVE"

    systemctl daemon-reload || return 1

    green "服务配置已更新"
}

# ------------------------------------------------------------
# 选择配置文件
# ------------------------------------------------------------

choose_config(){
    local -a files=()
    local choice i=0 f

    mapfile -t files < <(scan_configs)

    echo
    echo "检测到以下配置文件："
    echo "--------------------------------------------------"

    if (( ${#files[@]} == 0 )); then
        yellow "没有找到 .dae 配置文件"
        return 1
    fi

    for f in "${files[@]}"; do
        i=$((i+1))
        printf "%2d. %-30s %s\n" \
            "$i" "$f" "$(du -h "$ETC/$f" | awk '{print $1}')"
    done

    echo "0. 返回"

    read -r -p "请选择配置文件编号：" choice

    [[ "$choice" =~ ^[0-9]+$ ]] || {
        yellow "输入无效"
        return 1
    }

    (( choice == 0 )) && return 1

    (( choice >= 1 && choice <= ${#files[@]} )) || {
        yellow "编号无效"
        return 1
    }

    f="$ETC/${files[$((choice-1))]}"

    [[ -s "$f" && -r "$f" ]] || {
        red "配置文件为空或不可读取"
        return 1
    }

    set_service_config "$f" || return 1

    green "已选择配置：$f"
}

# ------------------------------------------------------------
# 导入配置
# ------------------------------------------------------------

import_config(){
    local source_file name destination

    read -r -p "请输入服务器上配置文件的完整路径：" source_file
    source_file="${source_file/#\~/$HOME}"

    [[ -f "$source_file" && -s "$source_file" && -r "$source_file" ]] || {
        red "文件不存在、为空或不可读取"
        return 1
    }

    [[ "$source_file" == *.dae ]] || {
        red "只允许导入 .dae 文件"
        return 1
    }

    name="$(basename "$source_file")"
    destination="$ETC/$name"

    if [[ -e "$destination" ]]; then
        destination="$ETC/imported-$(date +%Y%m%d-%H%M%S).dae"
    fi

    cp -a "$source_file" "$destination" || return 1
    chmod 600 "$destination"

    green "配置导入成功：$destination"
}

# ------------------------------------------------------------
# 创建基础配置
# ------------------------------------------------------------

create_basic_config(){
    local cfg="$ETC/config.min.dae"

    if [[ -e "$cfg" ]]; then
        cfg="$ETC/config-$(date +%Y%m%d-%H%M%S).dae"
    fi

    cat > "$cfg" <<'EOF'
global {
    wan_interface: auto
    log_level: info
    dial_mode: domain
    auto_config_kernel_parameter: true
}

routing {
    fallback: direct
}
EOF

    chmod 600 "$cfg"

    green "基础配置已创建：$cfg"
    yellow "这是直连基础配置，尚未添加代理节点或订阅"
}

# ------------------------------------------------------------
# 配置检查
# ------------------------------------------------------------

check_config(){
    local cfg

    cfg="$(get_active_config)"

    [[ -n "$cfg" && -f "$cfg" && -s "$cfg" && -r "$cfg" ]] || {
        red "当前没有有效配置文件"
        return 1
    }

    if grep -q 'https://example.com/sub' "$cfg"; then
        red "发现示例订阅地址，请先替换"
        return 1
    fi

    if ! grep -Eq '^global[[:space:]]*\{' "$cfg"; then
        red "没有检测到 global 配置区块"
        return 1
    fi

    if ! grep -Eq '^routing[[:space:]]*\{' "$cfg"; then
        red "没有检测到 routing 配置区块"
        return 1
    fi

    green "基础检查通过：$cfg"
    yellow "注意：基础检查不等于完整 DAE 语法验证"
}

# ------------------------------------------------------------
# 订阅管理
# ------------------------------------------------------------

add_subscription(){
    local cfg url tag route

    cfg="$(get_active_config)"

    [[ -n "$cfg" && -f "$cfg" ]] || {
        red "请先选择配置文件"
        return 1
    }

    echo
    echo "添加订阅"
    echo "--------------------------------------------------"

    read -r -p "请输入订阅链接：" url

    [[ "$url" =~ ^https?:// ]] || {
        red "订阅链接格式错误"
        return 1
    }

    [[ "$url" != *"'"* && "$url" != *'\'* ]] || {
        red "订阅链接包含不支持的字符"
        return 1
    }

    read -r -p "订阅标签 [managed_sub]：" tag
    tag="${tag:-managed_sub}"

    [[ "$tag" =~ ^[A-Za-z0-9_-]+$ ]] || {
        red "标签只允许字母、数字、下划线和短横线"
        return 1
    }

    read -r -p "下载路由：1.direct  2.proxy：" route
    [[ "$route" == "2" ]] && route="proxy" || route="direct"

    # 先备份
    cp -a "$cfg" "$cfg.$(date +%Y%m%d-%H%M%S).bak" || return 1

    HONK_CFG="$cfg" \
    HONK_URL="$url" \
    HONK_TAG="$tag" \
    HONK_ROUTE="$route" \
    python3 <<'PY'
import os,re,sys,tempfile

p=os.environ["HONK_CFG"]
url=os.environ["HONK_URL"]
tag=os.environ["HONK_TAG"]
route=os.environ["HONK_ROUTE"]

with open(p,encoding="utf-8") as f:
    s=f.read()

# 只识别顶层 subscription，不匹配 assets.subscription
m=re.search(r'(?m)^subscription[ \t]*\{',s)

entry=f"""
    {tag}: '{url}' {{
        route: {route}
    }}
"""

if m:
    start=s.find("{",m.start())
    depth=0
    quote=None
    escaped=False
    comment=False
    end=None

    for i in range(start,len(s)):
        c=s[i]

        if comment:
            if c=="\n":
                comment=False
            continue

        if quote:
            if escaped:
                escaped=False
            elif c=="\\":
                escaped=True
            elif c==quote:
                quote=None
            continue

        if c in ("'",'"'):
            quote=c
        elif c=="#":
            comment=True
        elif c=="{":
            depth+=1
        elif c=="}":
            depth-=1
            if depth==0:
                end=i
                break

    if end is None:
        sys.exit("subscription 区块括号不匹配，配置未修改")

    block=s[start:end+1]

    if re.search(r'(?m)^\s*'+re.escape(tag)+r'\s*:',block):
        sys.exit("订阅标签已经存在，配置未修改")

    s=s[:end]+entry+s[end:]

else:
    s=s.rstrip()+"\n\nsubscription {\n"+entry+"}\n"

directory=os.path.dirname(p)
fd,tmp=tempfile.mkstemp(prefix=".honk-",dir=directory)

try:
    with os.fdopen(fd,"w",encoding="utf-8") as f:
        f.write(s)
        f.flush()
        os.fsync(f.fileno())
    os.replace(tmp,p)
except Exception:
    try:
        os.unlink(tmp)
    except OSError:
        pass
    raise
PY

    if [[ $? -ne 0 ]]; then
        red "订阅写入失败，原配置备份已保留"
        return 1
    fi

    chmod 600 "$cfg"

    green "订阅添加成功"
    echo "配置文件：$cfg"
    echo "订阅标签：$tag"
    echo "原配置备份已保留"

    echo
    read -r -p "现在重载服务？[y/N]：" answer

    if [[ "$answer" =~ ^[Yy]$ ]]; then
        if systemctl is-active --quiet honk-core; then
            systemctl reload honk-core || {
                yellow "重载失败，请查看日志"
                return 1
            }
        else
            yellow "服务尚未运行"
        fi
    fi
}

# ------------------------------------------------------------
# 备份
# ------------------------------------------------------------

backup_config(){
    local cfg

    cfg="$(get_active_config)"

    [[ -n "$cfg" && -f "$cfg" ]] || {
        red "没有有效配置文件"
        return 1
    }

    mkdir -p "$ETC/backup"
    chmod 700 "$ETC/backup"

    cp -a "$cfg" \
        "$ETC/backup/$(basename "$cfg").$(date +%Y%m%d-%H%M%S).bak" || return 1

    green "配置备份完成：$ETC/backup"
}

# ------------------------------------------------------------
# 服务管理
# ------------------------------------------------------------

start_service(){
    check_config || return 1

    [[ -x "$BIN" ]] || {
        red "Honk 核心程序不存在"
        return 1
    }

    systemctl daemon-reload || return 1
    systemctl start honk-core || true
    sleep 2

    if systemctl is-active --quiet honk-core; then
        green "Honk 启动成功"
    else
        red "Honk 启动失败"
        journalctl -u honk-core -n 60 --no-pager -o cat
        return 1
    fi
}

stop_service(){
    systemctl stop honk-core || true

    if systemctl is-active --quiet honk-core; then
        red "停止服务失败"
        return 1
    fi

    green "Honk 已停止"
}

restart_service(){
    check_config || return 1

    systemctl restart honk-core || true
    sleep 2

    if systemctl is-active --quiet honk-core; then
        green "Honk 重启成功"
    else
        red "Honk 重启失败"
        journalctl -u honk-core -n 60 --no-pager -o cat
        return 1
    fi
}

reload_service(){
    if ! systemctl is-active --quiet honk-core; then
        yellow "服务尚未运行"
        return 1
    fi

    systemctl reload honk-core || {
        red "重载失败，请查看日志"
        return 1
    }

    green "配置重载完成"
}

# ------------------------------------------------------------
# 卸载
# ------------------------------------------------------------

uninstall_honk(){
    local choice confirm

    echo
    echo "=================================================="
    echo "                  卸载 HONK"
    echo "=================================================="
    echo
    echo "1. 卸载程序，保留配置和数据"
    echo "2. 完全卸载，删除配置和数据"
    echo "0. 返回管理面板"
    echo

    read -r -p "请选择：" choice

    case "$choice" in
        1)
            echo
            read -r -p "确认卸载程序？输入 YES：" confirm
            [[ "$confirm" == "YES" ]] || {
                yellow "已取消"
                return 0
            }

            systemctl disable --now honk-core 2>/dev/null || true

            rm -f "$UNIT" "$BIN" "$CMD" "$MANAGER"

            systemctl daemon-reload
            systemctl reset-failed honk-core 2>/dev/null || true

            green "Honk 程序已卸载"
            green "配置保留：$ETC"
            green "数据保留：$DATA"
            exit 0
            ;;

        2)
            echo
            red "警告：这将删除所有 Honk 配置和数据"
            read -r -p "确认彻底删除？输入 DELETE：" confirm

            [[ "$confirm" == "DELETE" ]] || {
                yellow "已取消"
                return 0
            }

            systemctl disable --now honk-core 2>/dev/null || true

            rm -f "$UNIT" "$BIN" "$CMD"
            rm -rf "$LIB" "$ETC" "$DATA"

            systemctl daemon-reload
            systemctl reset-failed honk-core 2>/dev/null || true

            green "Honk 已完全卸载"
            exit 0
            ;;

        *)
            return 0
            ;;
    esac
}

# ------------------------------------------------------------
# 菜单操作
# ------------------------------------------------------------

handle_choice(){
    local choice cfg

    read -r -p "请输入数字：" choice

    case "$choice" in
        0)
            echo
            green "已退出 HONK 管理面板"
            info "HONK 后台服务继续运行"
            exit 0
            ;;

        1)
            start_service
            ;;
        2)
            stop_service
            ;;
        3)
            restart_service
            ;;
        4)
            reload_service
            ;;
        5)
            systemctl status honk-core --no-pager -l || true
            ;;
        6)
            journalctl -u honk-core -n 100 --no-pager -o cat
            ;;
        7)
            echo "按 Ctrl+C 返回管理面板"
            sleep 1
            journalctl -fu honk-core -o cat
            ;;
        8)
            choose_config
            ;;
        9)
            add_subscription
            ;;
        10)
            cfg="$(get_active_config)"
            if [[ -n "$cfg" && -f "$cfg" ]]; then
                echo
                echo "当前配置：$cfg"
                echo "--------------------------------------------------"
                cat "$cfg"
            else
                red "没有有效配置文件"
            fi
            ;;
        11)
            backup_config
            ;;
        12)
            check_config
            ;;
        13)
            if import_config; then
                echo
                read -r -p "现在选择刚导入的配置？[Y/n]：" answer
                if [[ ! "$answer" =~ ^[Nn]$ ]]; then
                    choose_config
                fi
            fi
            ;;
        14)
            create_basic_config
            echo
            read -r -p "将新配置设为当前服务配置？[Y/n]：" answer
            if [[ ! "$answer" =~ ^[Nn]$ ]]; then
                cfg="$(find "$ETC" -maxdepth 1 -type f \
                    -name 'config*.dae' -printf '%T@ %p\n' |
                    sort -nr | head -n 1 | cut -d' ' -f2-)"
                [[ -n "$cfg" ]] && set_service_config "$cfg"
            fi
            ;;
        15)
            systemctl enable honk-core && green "已设置开机启动"
            ;;
        16)
            systemctl disable honk-core && green "已取消开机启动"
            ;;
        17)
            if [[ -x "$BIN" ]]; then
                "$BIN" --version
            else
                red "Honk 核心程序不存在"
            fi
            ;;
        18)
            uninstall_honk
            ;;
        *)
            yellow "无效选项，请重新输入"
            ;;
    esac
}

