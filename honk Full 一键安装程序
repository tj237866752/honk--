get_active_config(){
    local cfg=""

    if [[ -s "$ACTIVE" ]]; then
        cfg="$(cat "$ACTIVE")"
        if [[ -f "$cfg" ]]; then
            printf '%s\n' "$cfg"
            return 0
        fi
    fi

    systemctl show honk-core -p ExecStart --value 2>/dev/null |
        python3 -c '
