
#!/usr/bin/env bash
# ============================================================
# HONK 一键安装及管理程序
# Official: https://github.com/daeuniverse/honk
# Repository: https://github.com/tj237866752/honk--
# ============================================================

set -uo pipefail

REPO="daeuniverse/honk"
BIN="/usr/local/bin/honk-core"
CMD="/usr/local/bin/honk"
LIB="/usr/local/lib/honk"
MANAGER="$LIB/manager.sh"

ETC="/etc/honk"
DATA="/var/lib/honk"
UNIT="/etc/systemd/system/honk-core.service"
ACTIVE="$ETC/active-config"

TMP="$(mktemp -d)"
trap 'rm -rf "$TMP"' EXIT

RED='\033[31m'
GREEN='\033[32m'
YELLOW='\033[33m'
CYAN='\033[36m'
BLUE='\033[34m'
WHITE='\033[97m'
GRAY='\033[90m'
BOLD='\033[1m'
RESET='\033[0m'

red(){ printf "${RED}%s${RESET}\n" "$*"; }
green(){ printf "${GREEN}%s${RESET}\n" "$*"; }
yellow(){ printf "${YELLOW}%s${RESET}\n" "$*"; }
info(){ printf "${CYAN}%s${RESET}\n" "$*"; }

if [[ "$EUID" -ne 0 ]]; then
    red "请使用 root 运行"
    exit 1
fi

mkdir -p "$ETC" "$DATA"
chmod 700 "$ETC" "$DATA"

# ============================================================
# 依赖
# ============================================================

ensure_dependencies(){
    local missing=()

    for p in curl python3 tar sha256sum; do
        command -v "$p" >/dev/null 2>&1 || missing+=("$p")
    done

    if (( ${#missing[@]} > 0 )); then
        if ! command -v apt-get >/dev/null 2>&1; then
            red "缺少依赖，当前系统不支持 apt-get"
            return 1
        fi

        export DEBIAN_FRONTEND=noninteractive
        apt-get update || return 1
        apt-get install -y curl ca-certificates python3 tar gzip coreutils || return 1
    fi

    return 0
}

# ============================================================
# 下载并安装官方 Honk
# ============================================================

install_honk(){
    local arch releases asset release_url tag sums_url extracted

    case "$(uname -m)" in
        x86_64|amd64)
            arch="x86_64-unknown-linux-musl"
            ;;
        aarch64|arm64)
            arch="aarch64-unknown-linux-musl"
            ;;
        *)
            red "不支持的系统架构：$(uname -m)"
            return 1
            ;;
    esac

    echo
    info "正在获取 Honk 官方版本信息..."

    releases="$TMP/releases.json"

    curl -fsSL --retry 3 \
        -H "Accept: application/vnd.github+json" \
        "https://api.github.com/repos/$REPO/releases?per_page=100" \
        -o "$releases" || {
            red "获取官方版本列表失败"
            return 1
        }

    asset="$(python3 - "$releases" "$arch" <<'PY'
import json,sys

data=json.load(open(sys.argv[1],encoding="utf-8"))
arch=sys.argv[2]

for release in data:
    if release.get("draft"):
        continue

    candidates=[
        a for a in release.get("assets",[])
        if arch in a.get("name","")
        and "full" in a.get("name","").lower()
        and a.get("name","").endswith(".tar.gz")
    ]

    if candidates:
        candidates.sort(
            key=lambda a: (
                "stock" in a.get("name","").lower(),
                a.get("name","")
            ),
            reverse=True
        )
        print(candidates[0]["name"])
        break
PY
)"

    if [[ -z "$asset" ]]; then
        red "没有找到当前架构对应的官方 full 安装包"
        return 1
    fi

    read -r release_url tag < <(
        python3 - "$releases" "$asset" <<'PY'
import json,sys

for r in json.load(open(sys.argv[1],encoding="utf-8")):
    for a in r.get("assets",[]):
        if a.get("name")==sys.argv[2]:
            print(a["browser_download_url"],r["tag_name"])
            raise SystemExit
PY
    )

    if [[ -z "${release_url:-}" || -z "${tag:-}" ]]; then
        red "无法获取官方安装包地址"
        return 1
    fi

    echo "版本：$tag"
    echo "文件：$asset"

    curl -fL --retry 3 "$release_url" -o "$TMP/$asset" || {
        red "安装包下载失败"
        return 1
    }

    sums_url="$(python3 - "$releases" "$tag" <<'PY'
import json,sys

for r in json.load(open(sys.argv[1],encoding="utf-8")):
    if r.get("tag_name")==sys.argv[2]:
        for a in r.get("assets",[]):
            if a.get("name")=="SHA256SUMS":
                print(a["browser_download_url"])
                raise SystemExit
PY
)"

    if [[ -z "$sums_url" ]]; then
        red "官方没有提供 SHA256SUMS，停止安装"
        return 1
    fi

    curl -fL --retry 3 "$sums_url" -o "$TMP/SHA256SUMS" || return 1

    if ! grep -F " $asset" "$TMP/SHA256SUMS" >/dev/null; then
        red "校验文件中没有找到安装包记录"
        return 1
    fi

    (
        cd "$TMP" &&
        sha256sum -c --ignore-missing SHA256SUMS
    ) || {
        red "SHA256 校验失败"
        return 1
    }

    mkdir -p "$TMP/unpack"

    tar -xzf "$TMP/$asset" -C "$TMP/unpack" || {
        red "安装包解压失败"
        return 1
    }

    extracted="$(find "$TMP/unpack" -type f -name honk-core -print -quit)"

    if [[ -z "$extracted" ]]; then
        red "安装包中没有找到 honk-core"
        return 1
    fi

    install -m 0755 "$extracted" "$BIN" || return 1

    green "Honk 核心安装完成"
    "$BIN" --version || true
}

