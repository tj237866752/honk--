# ============================================================
# 安装后的配置流程
# ============================================================

configure_after_install(){
    local -a files=()
    local choice answer cfg

    mapfile -t files < <(
        find "$ETC" -maxdepth 1 -type f \
            -name "*.dae" \
            ! -name "*.example.dae" \
            ! -name "*.bak" \
            -printf '%f\n' | sort
    )

    echo
    echo "=================================================="
    echo "                 HONK 配置初始化"
    echo "=================================================="

    if (( ${#files[@]} > 0 )); then
        echo "发现已有配置文件："

        local i=0 f
        for f in "${files[@]}"; do
            i=$((i+1))
            printf "%2d. %s\n" "$i" "$f"
        done

        echo
        echo "1. 选择现有配置"
        echo "2. 导入其他配置"
        echo "3. 暂时跳过"
        read -r -p "请选择：" choice

        case "$choice" in
            1)
                "$CMD" || true
                return 0
                ;;
            2)
                read -r -p "请输入配置文件完整路径：" cfg
                if [[ -f "$cfg" && -s "$cfg" && "$cfg" == *.dae ]]; then
                    local dest="$ETC/$(basename "$cfg")"
                    [[ -e "$dest" ]] && dest="$ETC/imported-$(date +%s).dae"
                    cp -a "$cfg" "$dest"
                    chmod 600 "$dest"
                    green "配置导入完成：$dest"
                else
                    red "配置文件无效"
                fi
                ;;
            *)
                yellow "暂时跳过配置选择"
                return 0
                ;;
        esac
    else
        echo "没有发现现有配置文件"
        echo
        echo "1. 创建基础配置"
        echo "2. 导入现有配置"
        echo "3. 暂时跳过"
        read -r -p "请选择：" choice

        case "$choice" in
            1)
                cfg="$ETC/config.min.dae"
                [[ -e "$cfg" ]] && cfg="$ETC/config-$(date +%s).dae"

                cat > "$cfg" <<'EOF'
global {
    wan_interface: auto
    log_level: info
    dial_mode: domain
    auto_config_kernel_parameter: true
}

routing {
    fallback: direct
}
EOF
                chmod 600 "$cfg"
                green "基础配置已创建：$cfg"
                ;;
            2)
                read -r -p "请输入配置文件完整路径：" cfg
                if [[ -f "$cfg" && -s "$cfg" && "$cfg" == *.dae ]]; then
                    local dest="$ETC/$(basename "$cfg")"
                    [[ -e "$dest" ]] && dest="$ETC/imported-$(date +%s).dae"
                    cp -a "$cfg" "$dest"
                    chmod 600 "$dest"
                    cfg="$dest"
                else
                    red "配置文件无效"
                    return 0
                fi
                ;;
            *)
                yellow "暂时跳过配置初始化"
                return 0
                ;;
        esac
    fi

    # 如果已有 active-config，保留用户当前选择
    if [[ -s "$ACTIVE" && -f "$(cat "$ACTIVE")" ]]; then
        cfg="$(cat "$ACTIVE")"
    elif [[ -z "${cfg:-}" ]]; then
        mapfile -t files < <(
            find "$ETC" -maxdepth 1 -type f \
                -name "*.dae" ! -name "*.bak" \
                -printf '%T@ %p\n' | sort -nr |
                cut -d' ' -f2-
        )
        (( ${#files[@]} > 0 )) && cfg="${files[0]}"
    fi

    if [[ -n "${cfg:-}" && -f "$cfg" ]]; then
        printf '%s\n' "$cfg" > "$ACTIVE"
        chmod 600 "$ACTIVE"

        echo
        read -r -p "是否将此配置设为 Honk 服务配置？[Y/n]：" answer

        if [[ ! "$answer" =~ ^[Nn]$ ]]; then
            # 与管理程序保持一致的 systemd 参数
            cat > "$UNIT" <<EOF
[Unit]
Description=Honk eBPF Transparent Proxy Engine
Wants=network-online.target
After=network-online.target

[Service]
Type=notify
User=root
WorkingDirectory=$DATA
ExecStart=$BIN --config $cfg --disable-timestamp
ExecReload=$BIN reload
Restart=on-failure
RestartSec=3
TimeoutStopSec=30
LimitNOFILE=1048576
LimitMEMLOCK=infinity
UMask=0077

[Install]
WantedBy=multi-user.target
EOF
            systemctl daemon-reload || return 1
            green "服务配置已写入"
        fi

        echo
        read -r -p "现在添加订阅链接？[y/N]：" answer

        if [[ "$answer" =~ ^[Yy]$ ]]; then
            "$CMD"
            return 0
        fi

        echo
        read -r -p "现在启动 Honk 服务？[y/N]：" answer

        if [[ "$answer" =~ ^[Yy]$ ]]; then
            systemctl enable honk-core || true
            systemctl start honk-core || true
            sleep 2
            systemctl status honk-core --no-pager -l || true
        fi
    fi
}

