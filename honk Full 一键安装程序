
#!/bin/bash
set -Eeuo pipefail

VERSION="v0.1.0-beta.4"
ARCHIVE="honk-core-${VERSION}-x86_64-unknown-linux-musl-stock-full.tar.gz"
BASE_URL="https://github.com/daeuniverse/honk/releases/download/${VERSION}"

echo "======================================"
echo "       honk Full 一键安装程序"
echo "       Version: ${VERSION}"
echo "======================================"

if [ "$(id -u)" != "0" ]; then
    echo "错误：请使用 root 运行"
    exit 1
fi

if [ "$(uname -m)" != "x86_64" ]; then
    echo "错误：当前架构不是 x86_64"
    exit 1
fi

if ! command -v curl >/dev/null || ! command -v tar >/dev/null; then
    apt-get update
    apt-get install -y curl ca-certificates tar
fi

if [ ! -r /sys/kernel/btf/vmlinux ]; then
    echo "错误：缺少可读取的内核 BTF 文件"
    exit 1
fi

if ! mountpoint -q /sys/fs/bpf; then
    echo "错误：bpffs 尚未挂载"
    exit 1
fi

TMP_DIR="$(mktemp -d)"
trap 'rm -rf "$TMP_DIR"' EXIT

echo "[1/6] 下载官方 Full 安装包..."

curl -fL --retry 3 \
    "$BASE_URL/$ARCHIVE" \
    -o "$TMP_DIR/$ARCHIVE"

curl -fL --retry 3 \
    "$BASE_URL/SHA256SUMS" \
    -o "$TMP_DIR/SHA256SUMS"

echo "[2/6] 校验安装包..."

cd "$TMP_DIR"
sha256sum -c --ignore-missing SHA256SUMS

echo "[3/6] 解压安装..."

tar -xzf "$ARCHIVE" -C "$TMP_DIR"

BIN="$(find "$TMP_DIR" -type f -name honk-core -print -quit)"

if [ -z "$BIN" ]; then
    echo "错误：安装包中没有找到 honk-core"
    exit 1
fi

install -m 0755 "$BIN" /usr/local/bin/honk-core

echo "[4/6] 创建配置目录..."

mkdir -p /etc/honk
mkdir -p /var/lib/honk
chmod 700 /etc/honk
chmod 700 /var/lib/honk

if [ ! -f /etc/honk/config.dae.example ]; then
cat > /etc/honk/config.dae.example <<'EOF'
# honk 配置示例
# 修改并保存为 /etc/honk/config.dae 后才能启动服务

global {
    wan_interface: auto
    log_level: info
    data_dir: '/var/lib/honk'
    auto_config_kernel_parameter: false
    nfqueue_enable: false
    preconnect_node_count: 0
    udp_warm_node_count: 0
}

routing {
    fallback: direct
}
EOF
fi

echo "[5/6] 创建 systemd 服务..."

cat > /etc/systemd/system/honk-core.service <<'EOF'
[Unit]
Description=honk eBPF Transparent Proxy Engine
Wants=network-online.target
After=network-online.target

[Service]
Type=notify
User=root
WorkingDirectory=/var/lib/honk
ExecStart=/usr/local/bin/honk-core --config /etc/honk/config.dae --disable-timestamp
ExecReload=/usr/local/bin/honk-core reload
Restart=on-failure
RestartSec=3
TimeoutStopSec=30
LimitNOFILE=1048576
LimitMEMLOCK=infinity
UMask=0077

[Install]
WantedBy=multi-user.target
EOF

echo "[6/6] 创建快捷管理命令..."

cat > /usr/local/bin/honk <<'EOF'
#!/bin/bash

SERVICE="honk-core"
CONFIG="/etc/honk/config.dae"
EXAMPLE="/etc/honk/config.dae.example"

case "${1:-menu}" in

start)
    if [ ! -f "$CONFIG" ]; then
        echo "尚未创建正式配置文件。"
        echo "请先执行：honk config"
        exit 1
    fi
    systemctl start "$SERVICE"
    ;;

stop)
    systemctl stop "$SERVICE"
    ;;

restart)
    systemctl restart "$SERVICE"
    ;;

reload)
    systemctl reload "$SERVICE"
    ;;

status)
    systemctl status "$SERVICE" --no-pager
    ;;

logs)
    journalctl -u "$SERVICE" -n 100 --no-pager
    ;;

follow)
    journalctl -u "$SERVICE" -f
    ;;

config)
    if [ ! -f "$CONFIG" ]; then
        cp "$EXAMPLE" "$CONFIG"
        chmod 600 "$CONFIG"
        echo "已创建配置文件：$CONFIG"
    fi

    EDITOR_CMD="${EDITOR:-}"
    if [ -n "$EDITOR_CMD" ]; then
        $EDITOR_CMD "$CONFIG"
    elif command -v nano >/dev/null; then
        nano "$CONFIG"
    else
        vi "$CONFIG"
    fi
    ;;

enable)
    systemctl enable --now "$SERVICE"
    ;;

disable)
    systemctl disable --now "$SERVICE"
    ;;

version)
    /usr/local/bin/honk-core --version
    ;;

uninstall)
    echo "警告：将卸载 honk 并删除其配置和运行数据。"
    read -r -p "输入 YES 确认卸载：" ANSWER
    if [ "$ANSWER" != "YES" ]; then
        echo "取消卸载"
        exit 0
    fi

    systemctl disable --now "$SERVICE" 2>/dev/null || true
    rm -f /etc/systemd/system/honk-core.service
    systemctl daemon-reload
    systemctl reset-failed "$SERVICE" 2>/dev/null || true

    rm -f /usr/local/bin/honk-core
    rm -f /usr/local/bin/honk

    rm -rf /etc/honk
    rm -rf /var/lib/honk

    echo "honk 已卸载。"
    echo "未删除系统原有的内核模块、BPF 文件系统和其他软件。"
    exit 0
    ;;

menu)
    while true; do
        clear
        echo "================================"
        echo "          honk 管理菜单"
        echo "================================"
        echo "1. 启动"
        echo "2. 停止"
        echo "3. 重启"
        echo "4. 查看运行状态"
        echo "5. 查看日志"
        echo "6. 实时日志"
        echo "7. 编辑配置"
        echo "8. 设置开机启动"
        echo "9. 取消开机启动"
        echo "10. 查看版本"
        echo "11. 卸载 honk"
        echo "0. 退出"
        echo "================================"
        read -r -p "请输入数字：" N

        case "$N" in
            1) honk start ;;
            2) honk stop ;;
            3) honk restart ;;
            4) honk status ;;
            5) honk logs ;;
            6) honk follow ;;
            7) honk config ;;
            8) honk enable ;;
            9) honk disable ;;
            10) honk version ;;
            11) honk uninstall; exit 0 ;;
            0) exit 0 ;;
            *) echo "无效选项" ;;
        esac

        echo
        read -r -p "按回车返回菜单..."
    done
    ;;

*)
    echo "用法：honk {start|stop|restart|reload|status|logs|follow|config|enable|disable|version|uninstall}"
    ;;
esac
EOF

chmod 0755 /usr/local/bin/honk

systemctl daemon-reload

echo
echo "======================================"
echo "           安装完成"
echo "======================================"

/usr/local/bin/honk-core --version

echo
echo "快捷命令：honk"
echo "配置命令：honk config"
echo "服务尚未启动，也未设置开机启动。"
echo "======================================"
