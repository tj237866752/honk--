s=sys.stdin.read()
m=re.search(r"--config(?:=|\s+)([^\s;}]*)",s)
if m: print(m.group(1))
' 2>/dev/null
}

scan_configs(){
    find "$ETC" -maxdepth 1 -type f \
        -name "*.dae" \
        ! -name "*.example.dae" \
        ! -name "*.bak" \
        -printf '%f\n' 2>/dev/null | sort
}

