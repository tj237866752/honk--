
#!/usr/bin/env bash
# Honk 一键安装及管理脚本
# Honk Official: https://github.com/daeuniverse/honk
# Installer Repository: https://github.com/tj237866752/honk--

set -uo pipefail

REPO="daeuniverse/honk"
RAW_URL="https://raw.githubusercontent.com/tj237866752/honk--/refs/heads/main/honk%20Full%20%E4%B8%80%E9%94%AE%E5%AE%89%E8%A3%85%E7%A8%8B%E5%BA%8F"

BIN="/usr/local/bin/honk-core"
CMD="/usr/local/bin/honk"
LIB="/usr/local/lib/honk"
MANAGER="$LIB/manager.sh"

ETC="/etc/honk"
DATA="/var/lib/honk"
UNIT="/etc/systemd/system/honk-core.service"
ACTIVE="$ETC/active-config"

TMP="$(mktemp -d)"
trap 'rm -rf "$TMP"' EXIT

red(){ printf '\033[31m%s\033[0m\n' "$*"; }
green(){ printf '\033[32m%s\033[0m\n' "$*"; }
yellow(){ printf '\033[33m%s\033[0m\n' "$*"; }
line(){ echo "--------------------------------------------------"; }

if [[ "$EUID" -ne 0 ]]; then
    red "请使用 root 运行"
    exit 1
fi

mkdir -p "$ETC" "$DATA"
chmod 700 "$ETC" "$DATA"

# ==================================================
# 依赖检查
# ==================================================

ensure_dependencies(){
    local missing=()

    for p in curl python3 tar gzip sha256sum; do
        command -v "$p" >/dev/null 2>&1 || missing+=("$p")
    done

    if (( ${#missing[@]} > 0 )); then
        if ! command -v apt-get >/dev/null 2>&1; then
            red "缺少依赖，且当前系统不支持 apt-get"
            return 1
        fi

        export DEBIAN_FRONTEND=noninteractive
        apt-get update || return 1
        apt-get install -y curl ca-certificates python3 tar gzip coreutils || return 1
    fi
    return 0
}

# ==================================================
# 官方 Honk 下载与安装
# ==================================================

install_honk(){
    local arch releases asset tag sums_url release_url extracted

    case "$(uname -m)" in
        x86_64|amd64)
            arch="x86_64-unknown-linux-musl"
            ;;
        aarch64|arm64)
            arch="aarch64-unknown-linux-musl"
            ;;
        *)
            red "不支持的系统架构：$(uname -m)"
            return 1
            ;;
    esac

    echo
    echo "正在查询 Honk 官方 Releases..."

    releases="$TMP/releases.json"

    curl -fsSL --retry 3 \
        -H "Accept: application/vnd.github+json" \
        "https://api.github.com/repos/$REPO/releases?per_page=100" \
        -o "$releases" || {
            red "获取官方版本列表失败"
            return 1
        }

    asset="$(python3 - "$releases" "$arch" <<'PY'
import json,sys

data=json.load(open(sys.argv[1],encoding="utf-8"))
arch=sys.argv[2]

for release in data:
    if release.get("draft"):
        continue

    assets=release.get("assets",[])
    candidates=[
        a for a in assets
        if arch in a.get("name","")
        and "full" in a.get("name","").lower()
        and a.get("name","").endswith(".tar.gz")
    ]

    if candidates:
        candidates.sort(
            key=lambda a: ("stock" in a["name"].lower(),a["name"]),
            reverse=True
        )
        print(candidates[0]["name"])
        break
PY
)"

    if [[ -z "$asset" ]]; then
        red "没有找到适合当前架构的官方 full 安装包"
        return 1
    fi

    read -r release_url tag < <(
        python3 - "$releases" "$asset" <<'PY'
import json,sys
for r in json.load(open(sys.argv[1],encoding="utf-8")):
    for a in r.get("assets",[]):
        if a.get("name")==sys.argv[2]:
            print(a["browser_download_url"],r["tag_name"])
            raise SystemExit
PY
    )

    if [[ -z "${release_url:-}" || -z "${tag:-}" ]]; then
        red "无法获取安装包下载地址"
        return 1
    fi

    echo "版本：$tag"
    echo "安装包：$asset"

    curl -fL --retry 3 "$release_url" -o "$TMP/$asset" || {
        red "安装包下载失败"
        return 1
    }

    sums_url="$(python3 - "$releases" "$tag" <<'PY'
import json,sys
for r in json.load(open(sys.argv[1],encoding="utf-8")):
    if r.get("tag_name")==sys.argv[2]:
        for a in r.get("assets",[]):
            if a.get("name")=="SHA256SUMS":
                print(a["browser_download_url"])
                raise SystemExit
PY
)"

    if [[ -z "$sums_url" ]]; then
        red "官方版本没有提供 SHA256SUMS，停止安装"
        return 1
    fi

    curl -fL --retry 3 "$sums_url" -o "$TMP/SHA256SUMS" || return 1

    if ! grep -F " $asset" "$TMP/SHA256SUMS" >/dev/null; then
        red "SHA256SUMS 中没有找到安装包校验记录"
        return 1
    fi

    (
        cd "$TMP" &&
        sha256sum -c --ignore-missing SHA256SUMS
    ) || {
        red "安装包校验失败"
        return 1
    }

    mkdir -p "$TMP/unpack"

    tar -xzf "$TMP/$asset" -C "$TMP/unpack" || {
        red "安装包解压失败"
        return 1
    }

    extracted="$(find "$TMP/unpack" -type f -name honk-core -print -quit)"

    if [[ -z "$extracted" ]]; then
        red "安装包中没有找到 honk-core"
        return 1
    fi

    install -m 0755 "$extracted" "$BIN" || return 1

    green "Honk 核心安装完成"
    "$BIN" --version || true
}

# ==================================================
# 配置文件扫描
# ==================================================

scan_configs(){
    find "$ETC" -maxdepth 1 -type f \
        -name "*.dae" \
        ! -name "*.example.dae" \
        ! -name "*.bak" \
        -printf '%f\n' 2>/dev/null | sort
}

get_active_config(){
    if [[ -s "$ACTIVE" ]]; then
        local cfg
        cfg="$(cat "$ACTIVE")"
        if [[ -f "$cfg" ]]; then
            printf '%s\n' "$cfg"
            return 0
        fi
    fi

    systemctl show honk-core -p ExecStart --value 2>/dev/null |
        sed -n 's/.*--config[ =]*\([^ ;}"]*\).*/\1/p' |
        head -n 1
}

# ==================================================
# 选择配置文件
# ==================================================

choose_config(){
    local -a files=()
    local choice i=0 f

    mapfile -t files < <(scan_configs)

    echo
    line
    echo "扫描到的 Honk 配置文件"
    line

    if (( ${#files[@]} == 0 )); then
        yellow "没有发现 .dae 配置文件"
        return 1
    fi

    for f in "${files[@]}"; do
        i=$((i+1))
        printf "%2d. %-30s %s\n" \
            "$i" "$f" "$(du -h "$ETC/$f" | awk '{print $1}')"
    done

    echo "0. 返回"

    read -r -p "请选择配置文件编号：" choice

    [[ "$choice" =~ ^[0-9]+$ ]] || {
        yellow "输入无效"
        return 1
    }

    (( choice == 0 )) && return 1
    (( choice >= 1 && choice <= ${#files[@]} )) || {
        yellow "编号无效"
        return 1
    }

    f="$ETC/${files[$((choice-1))]}"

    [[ -s "$f" && -r "$f" ]] || {
        red "配置文件为空或不可读取"
        return 1
    }

    [[ "$f" != *" "* ]] || {
        red "配置文件名称不能包含空格"
        return 1
    }

    printf '%s\n' "$f" > "$ACTIVE"
    chmod 600 "$ACTIVE" "$f"

    green "已选择配置：$f"
    return 0
}

# ==================================================
# 导入配置文件
# ==================================================

import_config(){
    local source_file name destination

    echo
    read -r -p "请输入服务器上已有配置文件的完整路径：" source_file

    source_file="${source_file/#\~/$HOME}"

    [[ -f "$source_file" && -s "$source_file" && -r "$source_file" ]] || {
        red "文件不存在、为空或不可读取"
        return 1
    }

    [[ "$source_file" == *.dae ]] || {
        red "只允许导入 .dae 配置文件"
        return 1
    }

    name="$(basename "$source_file")"
    destination="$ETC/$name"

    if [[ -e "$destination" ]]; then
        destination="$ETC/imported-$(date +%Y%m%d-%H%M%S).dae"
    fi

    cp -a "$source_file" "$destination" || return 1
    chmod 600 "$destination"

    green "配置导入成功：$destination"
}

# ==================================================
# 创建官方最小配置
# ==================================================

create_basic_config(){
    local cfg="$ETC/config.dae"

    if [[ -e "$cfg" ]]; then
        cfg="$ETC/config-$(date +%Y%m%d-%H%M%S).dae"
    fi

    cat > "$cfg" <<'EOF'
global {
    wan_interface: auto
    data_dir: '/var/lib/honk'
    log_level: info
    dial_mode: domain
    auto_config_kernel_parameter: true
}

routing {
    fallback: direct
}
EOF

    chmod 600 "$cfg"
    printf '%s\n' "$cfg" > "$ACTIVE"

    green "最小配置已创建：$cfg"
    yellow "这是直连测试配置，尚未添加代理节点或订阅"
}

# ==================================================
# 更新 systemd 配置
# ==================================================

set_service_config(){
    local cfg="$1"
    local temp_unit="$TMP/honk-core.service"

    [[ -f "$cfg" && -s "$cfg" && -r "$cfg" ]] || {
        red "配置文件不存在、为空或不可读取"
        return 1
    }

    case "$cfg" in
        "$ETC/"*.dae) ;;
        *)
            red "配置文件必须位于 $ETC 目录"
            return 1
            ;;
    esac

    [[ "$cfg" != *" "* ]] || {
        red "配置文件路径不能包含空格"
        return 1
    }

    cat > "$temp_unit" <<EOF
[Unit]
Description=Honk eBPF Transparent Proxy Engine
Wants=network-online.target
After=network-online.target

[Service]
Type=notify
User=root
WorkingDirectory=$DATA
ExecStart=$BIN --config "$cfg" --disable-timestamp
ExecReload=$BIN reload
Restart=on-failure
RestartSec=3
TimeoutStopSec=30
LimitNOFILE=1048576
LimitMEMLOCK=infinity
UMask=0077

[Install]
WantedBy=multi-user.target
EOF

    install -m 0644 "$temp_unit" "$UNIT" || return 1
    printf '%s\n' "$cfg" > "$ACTIVE"
    chmod 600 "$ACTIVE"

    systemctl daemon-reload || return 1

    green "systemd 配置已更新"
}

# ==================================================
# 订阅编辑
# ==================================================

add_subscription(){
    local cfg url tag route answer

    cfg="$(get_active_config)"

    [[ -n "$cfg" && -f "$cfg" ]] || {
        red "请先选择配置文件"
        return 1
    }

    echo
    line
    echo "添加订阅"
    line

    read -r -p "请输入订阅链接：" url

    [[ "$url" =~ ^https?:// ]] || {
        red "订阅链接格式错误"
        return 1
    }

    [[ "$url" != *"'"* && "$url" != *'\'* ]] || {
        red "订阅链接包含不支持的字符"
        return 1
    }

    read -r -p "订阅标签 [managed_sub]：" tag
    tag="${tag:-managed_sub}"

    [[ "$tag" =~ ^[A-Za-z0-9_-]+$ ]] || {
        red "标签只允许字母、数字、下划线和短横线"
        return 1
    }

    read -r -p "下载路由：1.direct  2.proxy：" route
    case "$route" in
        2) route="proxy" ;;
        *) route="direct" ;;
    esac

    # 修改前备份
    cp -a "$cfg" "$cfg.$(date +%Y%m%d-%H%M%S).bak" || return 1

    HONK_CFG="$cfg" \
    HONK_URL="$url" \
    HONK_TAG="$tag" \
    HONK_ROUTE="$route" \
    python3 <<'PY'
import os,re,sys,tempfile

path=os.environ["HONK_CFG"]
url=os.environ["HONK_URL"]
tag=os.environ["HONK_TAG"]
route=os.environ["HONK_ROUTE"]

with open(path,encoding="utf-8") as f:
    text=f.read()

# 只匹配顶层 subscription，不匹配 assets.subscription
m=re.search(r'(?m)^subscription[ \t]*\{',text)

entry=f"""
    {tag}: '{url}' {{
        route: {route}
    }}
"""

if m:
    start=text.find("{",m.start())
    depth=0
    quote=None
    escaped=False
    comment=False
    end=None

    for i in range(start,len(text)):
        c=text[i]

        if comment:
            if c=="\n":
                comment=False
            continue

        if quote:
            if escaped:
                escaped=False
            elif c=="\\":
                escaped=True
            elif c==quote:
                quote=None
            continue

        if c in ("'",'"'):
            quote=c
        elif c=="#":
            comment=True
        elif c=="{":
            depth+=1
        elif c=="}":
            depth-=1
            if depth==0:
                end=i
                break

    if end is None:
        sys.exit("subscription 区块括号不匹配，配置未修改")

    block=text[start:end+1]

    if re.search(
        r'(?m)^\s*'+re.escape(tag)+r'\s*:',
        block
    ):
        sys.exit("订阅标签已经存在，配置未修改")

    text=text[:end]+entry+text[end:]

else:
    text=text.rstrip()+"\n\nsubscription {\n"+entry+"}\n"

# 原子写入，避免中途写入失败损坏配置
directory=os.path.dirname(path)
fd,tmp=tempfile.mkstemp(prefix=".honk-",dir=directory)

try:
    with os.fdopen(fd,"w",encoding="utf-8") as f:
        f.write(text)
        f.flush()
        os.fsync(f.fileno())
    os.replace(tmp,path)
except Exception:
    try:
        os.unlink(tmp)
    except OSError:
        pass
    raise
PY

    if [[ $? -ne 0 ]]; then
        red "订阅写入失败，原配置备份已保留"
        return 1
    fi

    chmod 600 "$cfg"

    green "订阅添加成功"
    echo "配置文件：$cfg"
    echo "订阅标签：$tag"
    echo "路由方式：$route"
    echo "原配置备份：$cfg.*.bak"

    read -r -p "现在重载服务？[y/N]：" answer

    if [[ "$answer" =~ ^[Yy]$ ]]; then
        if systemctl is-active --quiet honk-core; then
            systemctl reload honk-core || {
                yellow "重载失败，请查看服务日志"
                return 1
            }
        else
            yellow "服务尚未运行"
        fi
    fi
}

# ==================================================
# 配置检查
# ==================================================

check_config(){
    local cfg

    cfg="$(get_active_config)"

    [[ -n "$cfg" ]] || {
        red "尚未选择配置文件"
        return 1
    }

    [[ -f "$cfg" && -r "$cfg" && -s "$cfg" ]] || {
        red "配置文件不存在、不可读取或为空：$cfg"
        return 1
    }

    if grep -q 'https://example.com/sub' "$cfg"; then
        red "发现示例订阅地址，请删除或替换"
        return 1
    fi

    if ! grep -Eq '^global[[:space:]]*\{' "$cfg"; then
        red "没有检测到 global 配置区块"
        return 1
    fi

    if ! grep -Eq '^routing[[:space:]]*\{' "$cfg"; then
        red "没有检测到 routing 配置区块"
        return 1
    fi

    green "基础检查通过：$cfg"
    yellow "注意：基础检查不等于完整 DAE 语法验证"
    return 0
}

# ==================================================
# 服务管理
# ==================================================

start_service(){
    check_config || return 1

    [[ -x "$BIN" ]] || {
        red "Honk 核心程序不存在"
        return 1
    }

    systemctl daemon-reload || return 1
    systemctl start honk-core || true

    sleep 2

    if systemctl is-active --quiet honk-core; then
        green "Honk 已启动"
    else
        red "Honk 启动失败"
        journalctl -u honk-core -n 60 --no-pager -o cat
        return 1
    fi
}

stop_service(){
    systemctl stop honk-core
    systemctl status honk-core --no-pager -l || true
}

restart_service(){
    check_config || return 1
    systemctl restart honk-core || true
    sleep 2

    if systemctl is-active --quiet honk-core; then
        green "Honk 重启成功"
    else
        red "Honk 重启失败"
        journalctl -u honk-core -n 60 --no-pager -o cat
        return 1
    fi
}

backup_config(){
    local cfg
    cfg="$(get_active_config)"

    [[ -n "$cfg" && -f "$cfg" ]] || {
        red "没有有效配置文件"
        return 1
    }

    mkdir -p "$ETC/backup"
    chmod 700 "$ETC/backup"

    cp -a "$cfg" \
        "$ETC/backup/$(basename "$cfg").$(date +%Y%m%d-%H%M%S).bak" || return 1

    green "配置备份完成：$ETC/backup"
}

# ==================================================
# 管理程序部署
# ==================================================

install_manager(){
    local temp_manager="$TMP/manager.sh"

    mkdir -p "$LIB"

    echo "正在部署独立管理程序..."

    curl -fsSL --retry 3 "$RAW_URL" -o "$temp_manager" || {
        red "管理程序下载失败"
        return 1
    }

    bash -n "$temp_manager" || {
        red "管理程序语法检查失败"
        return 1
    }

    install -m 0755 "$temp_manager" "$MANAGER" || return 1

    cat > "$CMD" <<'EOF'
#!/usr/bin/env bash
if [[ "$EUID" -ne 0 ]]; then
    echo "请使用 root 运行"
    exit 1
fi
exec bash /usr/local/lib/honk/manager.sh menu "$@"
EOF

    chmod 0755 "$CMD"

    green "管理程序部署完成"
}

# ==================================================
# 卸载
# ==================================================

uninstall(){
    local choice confirm

    echo
    line
    echo "Honk 卸载"
    line
    echo "1. 仅卸载程序，保留配置和数据"
    echo "2. 完全卸载，包括配置和数据"
    echo "0. 取消"

    read -r -p "请选择：" choice

    case "$choice" in
        1)
            read -r -p "确认卸载程序？输入 YES：" confirm
            [[ "$confirm" == "YES" ]] || return 0

            systemctl disable --now honk-core 2>/dev/null || true

            rm -f "$UNIT" "$BIN" "$CMD"
            rm -f "$MANAGER"

            systemctl daemon-reload
            systemctl reset-failed honk-core 2>/dev/null || true

            green "程序已卸载"
            green "配置和数据保留在 $ETC 和 $DATA"
            exit 0
            ;;

        2)
            read -r -p "确认删除所有配置和数据？输入 DELETE：" confirm
            [[ "$confirm" == "DELETE" ]] || return 0

            systemctl disable --now honk-core 2>/dev/null || true

            rm -f "$UNIT" "$BIN" "$CMD"
            rm -rf "$LIB" "$ETC" "$DATA"

            systemctl daemon-reload
            systemctl reset-failed honk-core 2>/dev/null || true

            green "Honk 已完全卸载"
            exit 0
            ;;

        *)
            return 0
            ;;
    esac
}

# ==================================================
# 管理菜单
# ==================================================

manager(){
    while true; do
        local cfg status n

        cfg="$(get_active_config)"
        status="$(systemctl is-active honk-core 2>/dev/null || true)"

        echo
        line
        echo "                 HONK 管理面板"
        line
        echo "当前配置：${cfg:-未选择}"
        echo "服务状态：$status"
        line

        echo " 1. 启动服务"
        echo " 2. 停止服务"
        echo " 3. 重启服务"
        echo " 4. 重载配置"
        echo " 5. 查看服务状态"
        echo " 6. 查看最近日志"
        echo " 7. 实时日志"
        echo
        echo " 8. 扫描并选择配置文件"
        echo " 9. 添加订阅链接"
        echo "10. 查看当前配置"
        echo "11. 备份当前配置"
        echo "12. 检查配置文件"
        echo "13. 导入配置文件"
        echo "14. 创建最小配置"
        echo
        echo "15. 设置开机启动"
        echo "16. 取消开机启动"
        echo "17. 查看 Honk 版本"
        echo
        echo " 0. 卸载 Honk"
        line

        read -r -p "请输入数字：" n

        case "$n" in
            1) start_service || true ;;
            2) stop_service || true ;;
            3) restart_service || true ;;
            4)
                if systemctl is-active --quiet honk-core; then
                    systemctl reload honk-core || true
                else
                    yellow "服务尚未运行"
                fi
                ;;
            5) systemctl status honk-core --no-pager -l || true ;;
            6) journalctl -u honk-core -n 100 --no-pager -o cat ;;
            7) journalctl -fu honk-core -o cat ;;
            8)
                if choose_config; then
                    cfg="$(get_active_config)"
                    set_service_config "$cfg" || true
                    if systemctl is-active --quiet honk-core; then
                        read -r -p "配置已切换，是否重启服务？[y/N]：" answer
                        [[ "$answer" =~ ^[Yy]$ ]] && restart_service || true
                    fi
                fi
                ;;
            9) add_subscription || true ;;
            10)
                cfg="$(get_active_config)"
                if [[ -f "$cfg" ]]; then
                    cat "$cfg"
                else
                    red "配置文件不存在"
                fi
                ;;
            11) backup_config || true ;;
            12) check_config || true ;;
            13)
                if import_config; then
                    if choose_config; then
                        set_service_config "$(get_active_config)" || true
                    fi
                fi
                ;;
            14)
                create_basic_config
                set_service_config "$(get_active_config)" || true
                ;;
            15)
                systemctl enable honk-core && green "已设置开机启动"
                ;;
            16)
                systemctl disable honk-core && green "已取消开机启动"
                ;;
            17)
                if [[ -x "$BIN" ]]; then
                    "$BIN" --version
                else
                    red "Honk 核心程序不存在"
                fi
                ;;
            0) uninstall ;;
            *) yellow "无效选项" ;;
        esac

        echo
        read -r -p "按回车键返回菜单..." _
    done
}

# ==================================================
# 安装后的配置流程
# ==================================================

configure_after_install(){
    local cfg choice answer

    echo
    line
    echo "配置文件设置"
    line

    if [[ -n "$(scan_configs)" ]]; then
        if ! choose_config; then
            yellow "暂未选择配置文件"
            return 0
        fi
    else
        echo "1. 创建官方最小配置"
        echo "2. 导入现有配置文件"
        echo "0. 暂时跳过"

        read -r -p "请选择：" choice

        case "$choice" in
            1)
                create_basic_config
                ;;
            2)
                import_config || return 0
                choose_config || return 0
                ;;
            *)
                yellow "暂时跳过配置"
                return 0
                ;;
        esac
    fi

    cfg="$(get_active_config)"
    [[ -n "$cfg" && -f "$cfg" ]] || return 0

    set_service_config "$cfg" || return 1

    echo
    read -r -p "现在配置订阅链接？[Y/n]：" answer

    if [[ ! "$answer" =~ ^[Nn]$ ]]; then
        add_subscription || true
    fi

    echo
    read -r -p "现在启动 Honk 服务？[y/N]：" answer

    if [[ "$answer" =~ ^[Yy]$ ]]; then
        if check_config; then
            systemctl enable honk-core || true
            start_service || true
        fi
    fi
}

# ==================================================
# 安装入口
# ==================================================

if [[ "${1:-}" == "menu" ]]; then
    manager
    exit 0
fi

echo
line
echo "              HONK 安装程序"
line

ensure_dependencies || exit 1

if [[ -x "$BIN" ]]; then
    echo "检测到已安装 Honk："
    "$BIN" --version || true
    echo
    echo "1. 保留当前版本"
    echo "2. 更新到官方最新版本"

    read -r -p "请选择 [1/2]：" update_choice

    case "$update_choice" in
        2)
            install_honk || exit 1
            ;;
        *)
            green "保留当前 Honk 版本"
            ;;
    esac
else
    install_honk || exit 1
fi

# 先部署管理程序，确保后续配置流程中断也能使用管理命令
install_manager || exit 1

# 配置、订阅、systemd、启动
configure_after_install

echo
line
green "Honk 安装 / 更新流程完成"
echo "管理命令：honk"
echo "核心程序：$BIN"
echo "管理程序：$MANAGER"
echo "配置目录：$ETC"
echo "数据目录：$DATA"
line
